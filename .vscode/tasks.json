{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: CMake Build KeyPer",
            "type": "cppbuild",
            "command": "cmd",
            "args": [
                "/c",
                "if exist build (rmdir /s /q build) & mkdir build && cd build && cmake .. && cmake --build ."
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "build",
            "detail": "Builds with CMake."
        },
        {
            "type": "cmake",
            "label": "CMake: build",
            "command": "build",
            "targets": [
                "[N/A - Select Kit]"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "detail": "CMake template build task"
        }
    ]
}
